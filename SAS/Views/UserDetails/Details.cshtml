@model SAS.ViewModels.UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";

    bool editMode = ViewData["EditMode"] as bool? ?? false;

    bool isStaff = Model?.IsStaff ?? false;
}

<div class="container mt-4">
    <h3>Details</h3>

    @if (ViewBag.StatusMsg != null)

    {
        <p>@ViewBag.StatusMsg</p>
    }

    @if (Model != null)

    {
        @if (!editMode)

        {
            <div class="card p-3">
                @if (!isStaff)

                {
                    <p><strong>Subjects:</strong> @(Model.Subjects?.Any() == true ? string.Join(", ", Model.Subjects) : "—")</p>
                    <p><strong>Standards:</strong> @(Model.Std?.Any() == true ? string.Join(", ", Model.Std) : "—")</p>
                    <p><strong>Qualifications:</strong> @(Model.Qualifications?.Any() == true ? string.Join(", ", Model.Qualifications) : "—")</p>

                    <p><strong>Documents:</strong></p>
                    @if (Model.Documents?.Any() == true)

                    {
                        <ul>
                            @foreach (var doc in Model.Documents)

                            {
                                <li>
                                    <a href="@doc" target="_blank">
                                        @(doc.EndsWith(".pdf") ? "📄 PDF Document" : "🖼️ Image")
                                    </a>
                                </li>
                            }
                        </ul>
                    }

                    else

                    {
                        <p>—</p>
                    }
                }

                <p><strong>Salary:</strong> @(Model.Salary?.ToString() ?? "—")</p>
                <p><strong>Date of Birth:</strong> @(Model.Dob != DateTime.MinValue ? Model.Dob.ToString("dd/MM/yyyy") : "—")</p>

                <p><strong>Photo:</strong></p>
                @if (!string.IsNullOrEmpty(Model.Photo))

                {
                    <img src="@Model.Photo" style="width:120px;height:150px;object-fit:cover;border:1px solid #ccc;" />
                }

                else

                {
                    <p>—</p>
                }

                <p><strong>Experience:</strong> @(Model.Experience?.ToString() ?? "—") years</p>
                <p><strong>Joining Date:</strong> @(Model.JoiningDate != DateTime.MinValue ? Model.JoiningDate.ToString("dd/MM/yyyy") : "—")</p>
                <p><strong>Address:</strong> @(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</p>
                <p><strong>Phone:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</p>

                <form method="post" asp-action="ToggleEdit">
                    <button type="submit" class="btn btn-warning mt-3">Edit</button>
                </form>
            </div>
        }

        else

        {
            <form method="post" enctype="multipart/form-data" asp-action="UpdateDetails">
                <div class="card p-3">
                    @if (!isStaff)

                    {
                        <label class="mt-3">Subjects (comma separated)</label>
                        <input type="text" name="SubjectsText" class="form-control" value="@string.Join(", ", Model.Subjects ?? new List<string>())" />

                        <label class="mt-3">Standards (comma separated)</label>
                        <input type="text" name="StdText" class="form-control" value="@string.Join(", ", Model.Std ?? new List<int>())" />

                        <label class="mt-3">Qualifications (comma separated)</label>
                        <input type="text" name="QualificationsText" class="form-control" value="@string.Join(", ", Model.Qualifications ?? new List<string>())" />

                        <label class="mt-3">Documents</label>
                        <input type="file" name="NewDocuments" class="form-control" accept=".pdf,image/*" multiple />

                        @if (Model.Documents?.Any() == true)

                        {
                            <div class="mt-2">
                                <strong>Existing Documents:</strong>
                                <ul>
                                    @for (int i = 0; i < Model.Documents.Count; i++)

                                    {
                                        <li>
                                            <a href="@Model.Documents[i]" target="_blank">
                                                @(Model.Documents[i].EndsWith(".pdf") ? "📄 PDF Document" : "🖼️ Image")
                                            </a>
                                            <input type="checkbox" name="RemoveDocIndexes" value="@i" /> Remove
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }

                    <label class="mt-3">Salary</label>
                    <input type="number" name="Salary" class="form-control" value="@(Model.Salary.HasValue ? Model.Salary.Value.ToString("0.##") : "")" />

                    <label class="mt-3">Date of Birth</label>
                    <input type="date" name="Dob" class="form-control" value="@(Model.Dob != DateTime.MinValue ? Model.Dob.ToString("yyyy-MM-dd") : "")" />

                    <label class="mt-3">Experience (years)</label>
                    <input type="number" name="Experience" class="form-control" value="@(Model.Experience.HasValue ? Model.Experience.Value.ToString("0.##") : "")" />

                    <label class="mt-3">Joining Date</label>
                    <input type="date" name="JoiningDate" class="form-control" value="@(Model.JoiningDate != DateTime.MinValue ? Model.JoiningDate.ToString("yyyy-MM-dd") : "")" />

                    <label class="mt-3">Address</label>
                    <input type="text" name="Address" class="form-control" value="@Model.Address" />

                    <label class="mt-3">Phone</label>
                    <input type="text" name="Phone" class="form-control" value="@Model.Phone" />

                    <label class="mt-3">Photo</label>
                    <input type="file" name="PhotoFile" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.Photo))

                    {
                        <p class="mt-1">Current: <a href="@Model.Photo" target="_blank">View</a></p>
                    }

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success">Save</button>
                        <a asp-action="Details" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        }
    }
</div>