@model SAS.ViewModels.UserDetailsViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "User Details";



    bool editMode = ViewData["EditMode"] as bool? ?? false;
    var role = Context.Session.GetString("UserRole");
    bool isStaff = (role != null && role.ToLower() == "staff");
}

<div class="container mt-4">
    <h3>Details</h3>

    @if (ViewBag.StatusMsg != null)

    {
        <p class="alert alert-info">@ViewBag.StatusMsg</p>
    }

    <!-- Show validation errors -->
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    @if (Model != null)

    {
        @if (!editMode)

        {
            <div class="card p-3">
                @if (!isStaff)

                {
                    <p><strong>Subjects:</strong> @(string.IsNullOrEmpty(Model.Subjects) ? "—" : Model.Subjects)</p>
                    <p><strong>Standards:</strong> @(string.IsNullOrEmpty(Model.Stds) ? "—" : Model.Stds)</p>
                    <p><strong>Qualifications:</strong> @(string.IsNullOrEmpty(Model.Qualifications) ? "—" : Model.Qualifications)</p>

                    <p><strong>Documents:</strong></p>
                    @if (!string.IsNullOrEmpty(Model.Documents))

                    {

                        var docs = Model.Documents.Split(',', StringSplitOptions.RemoveEmptyEntries);
                        <ul>
                            @foreach (var doc in docs)

                            {
                                <li>
                                    <a href="@doc.Trim()" target="_blank">
                                        @(doc.EndsWith(".pdf") ? "📄 PDF Document" : "🖼️ Image")
                                    </a>
                                </li>
                            }
                        </ul>
                    }

                    else

                    {
                        <p>—</p>
                    }
                }

                <p><strong>Salary:</strong> @Model.Salary</p>
                <p><strong>Date of Birth:</strong> @Model.Dob.ToString("dd/MM/yyyy")</p>

                <p><strong>Photo:</strong></p>
                @if (!string.IsNullOrEmpty(Model.Photo))

                {
                    <img src="@Model.Photo" style="width:120px;height:150px;object-fit:cover;border:1px solid #ccc;" />
                }

                else

                {
                    <p>—</p>
                }

                <p><strong>Experience:</strong> @Model.Experience years</p>
                <p><strong>Joining Date:</strong> @Model.JoiningDate.ToString("dd/MM/yyyy")</p>
                <p><strong>Address:</strong> @Model.Address</p>
                <p><strong>Phone:</strong> @Model.Phone</p>

                <form method="post" asp-action="ToggleEdit">
                    <button type="submit" class="btn btn-warning mt-3">Edit</button>
                </form>
            </div>
        }

        else

        {
            <form method="post" enctype="multipart/form-data" asp-action="UpdateDetails">
                <div class="card p-3">
                    @if (!isStaff)

                    {
                        <label class="mt-3">Subjects (comma separated)</label>
                        <input asp-for="Subjects" class="form-control" />
                        <span asp-validation-for="Subjects" class="text-danger"></span>

                        <label class="mt-3">Standards (comma separated)</label>
                        <input asp-for="Stds" class="form-control" />
                        <span asp-validation-for="Stds" class="text-danger"></span>

                        <label class="mt-3">Qualifications (comma separated)</label>
                        <input asp-for="Qualifications" class="form-control" />
                        <span asp-validation-for="Qualifications" class="text-danger"></span>

                        <label class="mt-3">Documents</label>
                        <input type="file" asp-for="NewDocuments" class="form-control" accept=".pdf,image/*" multiple />

                        @if (!string.IsNullOrEmpty(Model.Documents))

                        {

                            var docs = Model.Documents.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <div class="mt-2">
                                <strong>Existing Documents:</strong>
                                <ul>
                                    @for (int i = 0; i < docs.Length; i++)

                                    {
                                        <li>
                                            <a href="@docs[i].Trim()" target="_blank">
                                                @(docs[i].Trim().EndsWith(".pdf") ? "📄 PDF Document" : "🖼️ Image")
                                            </a>
                                            <input type="checkbox" name="RemoveDocIndexes" value="@i" /> Remove
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }

                    <label class="mt-3">Salary</label>
                    <input asp-for="Salary" class="form-control" />
                    <span asp-validation-for="Salary" class="text-danger"></span>

                    <label class="mt-3">Date of Birth</label>
                    <input asp-for="Dob" type="date" class="form-control" />
                    <span asp-validation-for="Dob" class="text-danger"></span>

                    <label class="mt-3">Experience (years)</label>
                    <input asp-for="Experience" class="form-control" />
                    <span asp-validation-for="Experience" class="text-danger"></span>

                    <label class="mt-3">Joining Date</label>
                    <input asp-for="JoiningDate" type="date" class="form-control" />
                    <span asp-validation-for="JoiningDate" class="text-danger"></span>

                    <label class="mt-3">Address</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>

                    <label class="mt-3">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>

                    <label class="mt-3">Photo</label>
                    <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.Photo))

                    {
                        <p class="mt-1">Current: <a href="@Model.Photo" target="_blank">View</a></p>
                    }

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success">Save</button>
                        <a asp-action="Details" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        }
    }
</div>
