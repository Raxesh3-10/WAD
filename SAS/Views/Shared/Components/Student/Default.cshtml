@model List<SAS.ViewModels.StudentViewModel>
@using System.Text.Json

<div class="card shadow-lg rounded-3 mb-4 border-0" id="student-component">
    <!-- Create Student Form -->
    <div class="p-3">
        @await Html.PartialAsync("_CreateStudent", new SAS.ViewModels.StudentViewModel())
    </div>

    <!-- Student List -->
    <div class="p-3">
        @if (Model == null || !Model.Any())

        {
            <p class="text-muted text-center py-3">No students found.</p>
        }

        else

        {

            var stdOptions = Model.Select(s => s.Std).Distinct().OrderBy(x => x).ToList();

            var grouped = Model

            .GroupBy(s => s.Std)

            .ToDictionary(

            g => g.Key,

            g => g.GroupBy(s => s.Div)

            .ToDictionary(d => d.Key, d => d.ToList())

            );

            var groupedJson = JsonSerializer.Serialize(grouped);

            <div class="mb-4">
                <label for="stdSelect" class="form-label fw-semibold">Select Standard</label>
                <select id="stdSelect" class="form-select shadow-sm rounded-pill">
                    <option value="">-- Select Std --</option>
                    @foreach (var std in stdOptions)
                    {
                        <!-- value MUST match groupedJson keys exactly -->
                        <option value="@std">@std</option>
                    }
                </select>
            </div>

            <div class="mb-4">
                <label for="divSelect" class="form-label fw-semibold">Select Division</label>
                <select id="divSelect" class="form-select shadow-sm rounded-pill" disabled>
                    <option value="">-- Select Div --</option>
                </select>
            </div>

            <div class="d-flex justify-content-end mb-4">
                <form asp-controller="Student" asp-action="PromoteStudents" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                        <i class="bi bi-upload me-2"></i> New Year : Store Students' Records
                    </button>
                </form>
            </div>

            <div id="studentList" class="mb-3"></div>
            <div id="editStudentContainer" class="mt-4"></div>

            <script>
                const groupedStudents = @Html.Raw(groupedJson); // renamed from grouped
                const stdSelect = document.getElementById("stdSelect");
                const divSelect = document.getElementById("divSelect");
                const studentList = document.getElementById("studentList");

                stdSelect.addEventListener("change", function () {
                    const std = this.value.trim();
                    divSelect.innerHTML = '<option value="">-- Select Div --</option>';
                    divSelect.disabled = true;
                    studentList.innerHTML = "";
                    document.getElementById("editStudentContainer").innerHTML = "";

                    if (std && groupedStudents[std]) {
                        const divs = Object.keys(groupedStudents[std]);
                        if (divs.length > 0) {
                            divs.forEach(div => {
                                let opt = document.createElement("option");
                                opt.value = div;
                                opt.textContent = "Division " + div;
                                divSelect.appendChild(opt);
                            });
                            divSelect.disabled = false;
                        } else {
                            let opt = document.createElement("option");
                            opt.value = "";
                            opt.textContent = "No divisions available";
                            divSelect.appendChild(opt);
                        }
                    }
                });

                divSelect.addEventListener("change", function () {
                    const std = stdSelect.value.trim();
                    const div = this.value.trim();
                    studentList.innerHTML = "";
                    document.getElementById("editStudentContainer").innerHTML = "";

                    if (std && div && groupedStudents[std] && groupedStudents[std][div]) {
                        const ul = document.createElement("ul");
                        ul.className = "list-group shadow-sm";

                        groupedStudents[std][div].forEach(student => {
                            const li = document.createElement("li");
                            li.className = "list-group-item d-flex justify-content-between align-items-center border-0 border-bottom";

                            li.innerHTML = `
                                    <div class="d-flex align-items-center">
                                        ${student.PhotoUrl ? `<img src="${student.PhotoUrl}" class="rounded-circle me-3 shadow-sm" style="width:50px;height:50px;object-fit:cover;">` : ''}
                                        <span class="fw-semibold">${student.StudentName}</span>
                                        <small class="text-muted ms-2">(Roll ${student.RollNo})</small>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button"
                                            class="btn btn-sm btn-outline-primary edit-student-btn rounded-pill"
                                            data-email="${student.Email}">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                        <form action="/Student/DeleteStudentConfirmed" method="post" class="d-inline">
                                            <input type="hidden" name="email" value="${student.Email}" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                `;
                            ul.appendChild(li);
                        });

                        studentList.appendChild(ul);
                    }
                });

                document.addEventListener("click", function (e) {
                    if (e.target && e.target.classList.contains("edit-student-btn")) {
                        const email = e.target.getAttribute("data-email");

                        fetch(`/Student/GetStudent?email=${encodeURIComponent(email)}`, {
                            method: "GET",
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        })
                            .then(response => response.text())
                            .then(html => {
                                document.getElementById("editStudentContainer").innerHTML = html;
                            })
                            .catch(err => console.error("Error loading edit form:", err));
                    }
                });
            </script>

        }
    </div>
</div>
