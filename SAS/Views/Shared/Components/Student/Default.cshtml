@model List<SAS.ViewModels.StudentViewModel>
@using System.Text.Json

<div class="card shadow-sm mb-4" id="student-component">
    <div class="tab-content">
        <div class="tab-pane fade show active p-3">
            @await Html.PartialAsync("_CreateStudent", new SAS.ViewModels.StudentViewModel())
        </div>

        <div class="tab-pane fade show active p-3">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No students found.</p>
            }
            else
            {

                var stdOptions = Model.Select(s => s.Std).Distinct().OrderBy(x => x).ToList();



                var grouped = Model

                .GroupBy(s => s.Std)

                .ToDictionary(

                g => g.Key,

                g => g.GroupBy(s => s.Div)

                .ToDictionary(d => d.Key, d => d.ToList())

                );



                var groupedJson = JsonSerializer.Serialize(grouped);

                <div class="mb-3">
                    <label for="stdSelect" class="form-label">Select Standard</label>
                    <select id="stdSelect" class="form-select">
                        <option value="">-- Select Std --</option>
                        @foreach (var std in stdOptions)

                        {
                            <option value="@std">Std @std</option>
                        }
                    </select>
                </div>

                <div class="mb-3" id="divContainer" style="display:none;">
                    <label for="divSelect" class="form-label">Select Division</label>
                    <select id="divSelect" class="form-select">
                        <option value="">-- Select Div --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end mb-3">
                    <form asp-controller="Student" asp-action="PromoteStudents" method="post" class="d-inline">
                        <button type="submit" class="btn btn-success">
                            New Year : Storing Students' records
                        </button>
                    </form>
                </div>

                <div id="studentList"></div>
                <div id="editStudentContainer" class="mt-4"></div>

                <script>
                    const grouped = @Html.Raw(groupedJson);
                    const stdSelect = document.getElementById("stdSelect");
                    const divContainer = document.getElementById("divContainer");
                    const divSelect = document.getElementById("divSelect");
                    const studentList = document.getElementById("studentList");

                    stdSelect.addEventListener("change", function () {
                        const std = this.value;
                        divSelect.innerHTML = '<option value="">-- Select Div --</option>';
                        studentList.innerHTML = "";
                        document.getElementById("editStudentContainer").innerHTML = "";

                        if (std && grouped[std]) {
                            divContainer.style.display = "block";
                            const divs = Object.keys(grouped[std]);
                            divs.forEach(div => {
                                let opt = document.createElement("option");
                                opt.value = div;
                                opt.textContent = "Division " + div;
                                divSelect.appendChild(opt);
                            });
                        } else {
                            divContainer.style.display = "none";
                        }
                    });

                    divSelect.addEventListener("change", function () {
                        const std = stdSelect.value;
                        const div = this.value;
                        studentList.innerHTML = "";
                        document.getElementById("editStudentContainer").innerHTML = "";

                        if (std && div && grouped[std][div]) {
                            const ul = document.createElement("ul");
                            ul.className = "list-group";

                            grouped[std][div].forEach(student => {
                                const li = document.createElement("li");
                                li.className = "list-group-item d-flex justify-content-between align-items-center";

                                li.innerHTML = `
                                                        <div class="d-flex align-items-center">
                                                            ${student.PhotoUrl ? `<img src="${student.PhotoUrl}" class="img-thumbnail me-2" style="width:50px;height:50px;">` : ''}
                                                            <span>${student.StudentName} (Roll ${student.RollNo})</span>
                                                        </div>
                                                        <div>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-primary me-2 edit-student-btn"
                                                                    data-email="${student.Email}">
                                                                Edit
                                                            </button>
                                                            <form action="/Student/DeleteStudentConfirmed" method="post" class="d-inline">
                                                                <input type="hidden" name="email" value="${student.Email}" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                            </form>
                                                        </div>
                                                    `;
                                ul.appendChild(li);
                            });

                            studentList.appendChild(ul);
                        }
                    });

                    document.addEventListener("click", function (e) {
                        if (e.target && e.target.classList.contains("edit-student-btn")) {
                            const email = e.target.getAttribute("data-email");

                            fetch(`/Student/GetStudent?email=${encodeURIComponent(email)}`, {
                                method: "GET",
                                headers: { "X-Requested-With": "XMLHttpRequest" }
                            })
                                .then(response => response.text())
                                .then(html => {
                                    document.getElementById("editStudentContainer").innerHTML = html;
                                })
                                .catch(err => console.error("Error loading edit form:", err));
                        }
                    });
                </script>
            }
        </div>
    </div>
</div>