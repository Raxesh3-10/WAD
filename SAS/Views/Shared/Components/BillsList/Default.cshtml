@model List<SAS.ViewModels.BillViewModel>
@using System.Text.Json
@using SAS.Models
@{
    var userRole = Context.Session.GetString("UserRole");
}
<div class="card shadow-sm mb-4" id="bill-component">
    <div class="tab-content">
        <h4 class="card-title fw-bold text-center text-dark-cyan-contrast" style="color: #006060;">BILLS</h4>
        @if (userRole != null && userRole.ToLower() == "staff")
        {
            <div class="tab-pane fade show active p-3">
                @await Html.PartialAsync("_CreateBill", new SAS.ViewModels.BillViewModel())
            </div>
        }
        <div class="tab-pane fade show active p-3">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No bills found.</p>
            }
            else
            {
                var billTypeOptions = Model.Select(b => b.Type).Distinct().OrderBy(x => x).ToList();

                var grouped = Model
                    .GroupBy(b => b.Type)
                    .ToDictionary(
                        g => g.Key.ToString(),
                        g => g.GroupBy(b => b.BillDate.ToString("yyyy-MM-dd"))
                              .ToDictionary(d => d.Key, d => d.ToList())
                    );

                var groupedJson = JsonSerializer.Serialize(grouped);

                <div class="mb-3">
                    <label for="billTypeSelect" class="form-label">Select Bill Type</label>
                    <select id="billTypeSelect" class="form-select">
                        <option value="">-- Select Bill Type --</option>
                        @foreach (var type in billTypeOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div class="mb-3" id="billDateContainer" style="display:none;">
                    <label for="billDateSelect" class="form-label">Select Bill Date</label>
                    <select id="billDateSelect" class="form-select">
                        <option value="">-- Select Date --</option>
                    </select>
                </div>

                <div id="billList"></div>
                <div id="editBillContainer" class="mt-4"></div>

                <script>
                    const grouped = @Html.Raw(groupedJson);
                    const typeSelect = document.getElementById("billTypeSelect");
                    const dateContainer = document.getElementById("billDateContainer");
                    const dateSelect = document.getElementById("billDateSelect");
                    const billList = document.getElementById("billList");

                    typeSelect.addEventListener("change", function () {
                        const type = this.value;
                        dateSelect.innerHTML = '<option value="">-- Select Date --</option>';
                        billList.innerHTML = "";
                        document.getElementById("editBillContainer").innerHTML = "";

                        if (type && grouped[type]) {
                            dateContainer.style.display = "block";
                            const dates = Object.keys(grouped[type]);
                            dates.forEach(date => {
                                let opt = document.createElement("option");
                                opt.value = date;
                                opt.textContent = date;
                                dateSelect.appendChild(opt);
                            });
                        } else {
                            dateContainer.style.display = "none";
                        }
                    });

                    dateSelect.addEventListener("change", function () {
                        const type = typeSelect.value;
                        const date = this.value;
                        billList.innerHTML = "";
                        document.getElementById("editBillContainer").innerHTML = "";

                        if (type && date && grouped[type][date]) {
                            const ul = document.createElement("ul");
                            ul.className = "list-group";

                            grouped[type][date].forEach(bill => {
                                const li = document.createElement("li");
                                li.className = "list-group-item d-flex justify-content-between align-items-center";

                                const formattedDate = bill.BillDate.split("T")[0];

                                let docsHtml = "";
                                if (bill.Documents) {
                                    const docs = bill.Documents.split(";");
                                    docsHtml = docs.map((doc, i) =>
                                        `<a href="${doc}" target="_blank" class="me-2">Doc ${i + 1}</a>`
                                    ).join("");
                                }

                                li.innerHTML = `
                                    <div>
                                        Amount: ₹${bill.Amount} - Vendor: ${bill.VendorName ?? ''} - Email: ${bill.VendorEmail ?? ''}
                                        <div>${docsHtml}</div>
                                    </div>
                                    <div>
                                        <button type="button" action="/Bills/Edit/${bill.Id}" method="get"
                                                class="btn btn-sm btn-outline-primary me-2 edit-bill-btn"
                                                data-id="${bill.Id}">
                                            Edit
                                        </button>
                                        <form action="/Bills/Delete/${bill.Id}" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                `;
                                ul.appendChild(li);
                            });

                            billList.appendChild(ul);
                        }
                    });

                    document.addEventListener("click", function (e) {
                        if (e.target && e.target.classList.contains("edit-bill-btn")) {
                            const id = e.target.getAttribute("data-id");

                            fetch(`/Bills/Edit/${id}`, {
                                method: "GET",
                                headers: { "X-Requested-With": "XMLHttpRequest" }
                            })
                                .then(response => response.text())
                                .then(html => {
                                    document.getElementById("editBillContainer").innerHTML = html;
                                })
                                .catch(err => console.error("Error loading edit form:", err));
                        }
                    });
                </script>
            }
        </div>
    </div>
</div>