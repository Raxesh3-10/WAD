@model SAS.ViewModels.ReportBugViewModel
@{
    ViewData["Title"] = "Report Bug";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card p-5 shadow-lg rounded-4 border-0">
        <div class="card-body">
            <h4 class="card-title text-center fw-bolder mb-5" style="color: #008080;">REPORT A BUG</h4>

            <form asp-action="ReportBug" asp-controller="User" method="post" class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label text-muted"></label>
                    <input asp-for="Name" class="form-control form-control-lg bg-light border-0" readonly />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label text-muted"></label>
                    <input asp-for="Email" class="form-control form-control-lg bg-light border-0" readonly />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Message" class="form-label text-muted"></label>
                    <textarea asp-for="Message" class="form-control form-control-lg bg-light border-0" rows="5" placeholder="Describe the bug..." required></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>
                <div class="col-12 mt-5">
                    <button type="submit" class="btn w-100 btn-lg fw-bold" style="background-color: #008080; color: white;">Send Report</button>
                </div>
                @if (!string.IsNullOrEmpty(Model?.StatusMessage))
                {
                <p class="text-center mt-4 alert alert-info fade show">@Model.StatusMessage</p>
                }
            </form>
        </div>
    </div>
</div>