@model SAS.ViewModels.TimetableViewModel

<div class="container mt-4">
    <h3>Generate Timetable</h3>
    <form asp-controller="Timetable" asp-action="GenerateTimetable" method="post" class="row g-3" target="_blank">
        <div class="col-md-4">
            <label>Lecture Duration (minutes)</label>
            <input asp-for="LectureDuration" class="form-control" type="number" required />
            <span asp-validation-for="LectureDuration" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label>Start Time</label>
            <input asp-for="StartTime" class="form-control" type="time" required />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label>End Time</label>
            <input asp-for="EndTime" class="form-control" type="time" required />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label>Lunch Start</label>
            <input asp-for="LunchStart" class="form-control" type="time" required />
            <span asp-validation-for="LunchStart" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label>Lunch Duration (minutes)</label>
            <input asp-for="LunchDuration" class="form-control" type="number" required />
            <span asp-validation-for="LunchDuration" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label>Days in Week</label>
            <input asp-for="DaysInWeek" class="form-control" type="number" min="5" max="6" required />
            <span asp-validation-for="DaysInWeek" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label>Standard (STD)</label>
            <input asp-for="Stds" class="form-control" type="number" required />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary w-100">Generate Timetable PDF</button>
        </div>
    </form>
</div>
