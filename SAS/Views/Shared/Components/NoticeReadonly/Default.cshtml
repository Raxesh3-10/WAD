@model List<SAS.ViewModels.NoticeViewModel>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h4 class="card-title">Notices</h4>

        @if (Model == null || !Model.Any())

        {
                <p class="text-muted">No notices available.</p>
        }

        else

        {
                <ul class="list-group">
                @foreach (var n in Model)
                {
                            <li class="list-group-item">
                                <div class="mb-2">
                                    <strong>@n.Subject</strong><br />
                                    <span>@n.Message</span><br />
                                    <small class="text-muted">Date: @n.Date.ToShortDateString()</small>
                                </div>

                        @if (!string.IsNullOrEmpty(n.Documents))

                        {

                            var docs = n.Documents.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                @for (int i = 0; i < docs.Length; i++)

                                {
                                                    <div class="border p-2 rounded small d-flex align-items-center">
                                                        <a href="@docs[i]" target="_blank">Doc @(i + 1)</a>
                                                    </div>
                                }
                                        </div>
                        }
                            </li>
                }
                </ul>
        }
    </div>
</div>