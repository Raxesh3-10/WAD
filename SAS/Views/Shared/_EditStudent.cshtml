@model SAS.ViewModels.StudentViewModel

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title">Edit Student</h5>

        <form asp-action="EditStudent" asp-controller="Student" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" /> <!-- Keep email fixed -->

            <div class="mb-3">
                <label asp-for="StudentName" class="form-label"></label>
                <input asp-for="StudentName" class="form-control" />
                <span asp-validation-for="StudentName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FatherName" class="form-label"></label>
                <input asp-for="FatherName" class="form-control" />
                <span asp-validation-for="FatherName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MotherName" class="form-label"></label>
                <input asp-for="MotherName" class="form-control" />
                <span asp-validation-for="MotherName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AadharNo" class="form-label"></label>
                <input asp-for="AadharNo" class="form-control" />
                <span asp-validation-for="AadharNo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RollNo" class="form-label"></label>
                <input asp-for="RollNo" class="form-control" />
                <span asp-validation-for="RollNo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Div" class="form-label"></label>
                <input asp-for="Div" class="form-control" />
                <span asp-validation-for="Div" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Std" class="form-label"></label>
                <input asp-for="Std" class="form-control" />
                <span asp-validation-for="Std" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNo" class="form-label"></label>
                <input asp-for="PhoneNo" class="form-control" />
                <span asp-validation-for="PhoneNo" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Update</button>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('editStudentContainer').innerHTML=''">Cancel</button>
        </form>
    </div>
</div>
