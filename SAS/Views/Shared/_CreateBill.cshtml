@model SAS.ViewModels.BillViewModel

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card p-5 shadow-lg rounded-4 border-0" style="max-width: 600px; width: 100%;">
        <div class="card-body">
            <h4 class="card-title text-center fw-bolder mb-5" style="color: #006060;">CREATE BILL</h4>

            <form asp-controller="Bills" asp-action="Create" method="post" enctype="multipart/form-data" class="row g-4">
                <div class="col-12">
                    <label asp-for="Type" class="form-label text-muted"></label>
                    <div class="input-group">
                        <select asp-for="Type" class="form-select form-control-lg bg-light border-0" asp-items="Html.GetEnumSelectList<SAS.Models.BillType>()" required></select>
                    </div>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Amount" class="form-label text-muted"></label>
                    <input asp-for="Amount" class="form-control form-control-lg bg-light border-0" placeholder="Amount" type="number"  required/>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="BillDate" class="form-label text-muted"></label>
                    <input asp-for="BillDate" type="date" class="form-control form-control-lg bg-light border-0" required />
                    <span asp-validation-for="BillDate" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label text-muted">Upload Documents</label>
                    <input asp-for="NewDocuments" type="file" class="form-control form-control-lg" multiple />
                </div>

                <div class="col-12 mt-5">
                    <button type="submit" class="btn btn-primary w-100 btn-lg fw-bold" style="background-color: #006060; color: white;">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>