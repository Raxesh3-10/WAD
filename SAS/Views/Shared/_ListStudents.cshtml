@model List<SAS.ViewModels.StudentViewModel>

@if (Model == null || !Model.Any())
{
    <p class="text-muted">No students found.</p>
}
else
{
    var grouped = Model
        .GroupBy(s => s.Std)
        .ToDictionary(g => g.Key, g => g.GroupBy(s => s.Div));

    foreach (var std in grouped)

    {
        <h6>Standard @std.Key</h6>
        foreach (var div in std.Value)

        {
            <button class="btn btn-secondary w-100 text-start mb-2" type="button"
                    data-bs-toggle="collapse" data-bs-target="#div-@std.Key-@div.Key">
                ▶ Division @div.Key
            </button>

            <ul class="list-group collapse" id="div-@std.Key-@div.Key">
                @foreach (var student in div)

                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@student.StudentName (Roll @student.RollNo)</span>
                        <div>
                            <a asp-action="EditStudent" asp-controller="Student" asp-route-email="@student.Email"
                               class="btn btn-sm btn-outline-primary me-2">Edit</a>
                            <a asp-action="DeleteStudent" asp-controller="Student" asp-route-email="@student.Email"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </li>
                }
            </ul>
        }
    }
}