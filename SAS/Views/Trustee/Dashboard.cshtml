@using SAS.ViewModels
@{
    ViewData["Title"] = "Trustee Dashboard";

    var profile = ViewBag.Profile as UserViewModel;



    var teachers = ViewBag.Teachers as List<DetailsViewModel>;

    var staffs = ViewBag.Staffs as List<DetailsViewModel>;

    var principals = ViewBag.Principals as List<DetailsViewModel>;



    var teacherSalary = ViewBag.TotalTeacherSalary ?? 0;

    var principalSalary = ViewBag.TotalPrincipalSalary ?? 0;

    var staffSalary = ViewBag.TotalStaffSalary ?? 0;

    var totalSalary = teacherSalary + principalSalary + staffSalary;
}

<div class="container mt-4">
    <!-- Profile -->
    <div class="card mb-4" style="border: 2px solid #008080;">
        <div class="card-body">
            <h3 class="text-dark">
                Welcome, @profile?.Name
                <small class="text-secondary fw-bold">(@profile?.Role)</small>
            </h3>
            <p class="text-dark"><strong>Email:</strong> @profile?.Email</p>
        </div>
    </div>

    @await Component.InvokeAsync("Notice")
    @await Component.InvokeAsync("ReportBug", new { name = profile?.Name, email = profile?.Email })

    <!-- Salary Distribution Pie Chart -->
    <div class="card mt-4">
        <div class="card-header text-white" style="background-color: #008080;">Salary Distribution</div>
        <div class="card-body text-center">
            <canvas id="salaryPieChart" style="max-height:400px;"></canvas>
            <p class="mt-3">
                <strong>Total Salary:</strong> ₹@totalSalary.ToString("N0")
            </p>
        </div>
    </div>

    <!-- Principals Section -->
    <div class="card mt-4">
        <div class="card-header text-white" style="background-color: #008080;">Principals</div>
        <div class="card-body">
            @if (principals != null && principals.Any())
            {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Salary</th>
                        <th>DOB</th>
                        <th>Experience</th>
                        <th>Joining Date</th>
                        <th>Subjects</th>
                        <th>Standards</th>
                        <th>Qualifications</th>
                        <th>Documents</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var principal in principals)

                        {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(principal.details?.Photo))

                                    {
                            <img src="@principal.details.Photo" alt="Photo" style="width:50px;height:50px;" />
                                    }
                        </td>
                        <td>@principal.user?.Name</td>
                        <td>@principal.user?.Email</td>
                        <td>@principal.details?.Phone</td>
                        <td>@principal.details?.Address</td>
                        <td>@principal.details?.Salary.ToString("C")</td>
                        <td>@principal.details?.Dob.ToShortDateString()</td>
                        <td>@principal.details?.Experience</td>
                        <td>@principal.details?.JoiningDate.ToShortDateString()</td>
                        <td>@principal.details?.Subjects</td>
                        <td>@principal.details?.Stds</td>
                        <td>@principal.details?.Qualifications</td>
                        <td>
                            @if (!string.IsNullOrEmpty(principal.details?.Documents))

                                    {

                                        foreach (var doc in principal.details.Documents.Split(',', StringSplitOptions.RemoveEmptyEntries))

                                        {
                            <a href="@doc.Trim()" target="_blank">View</a>

                            <br />
                                        }

                                    }
                        </td>
                    </tr>
                        }
                </tbody>
            </table>
            }
            else
            {
            <p class="text-muted">No principals found.</p>
            }
        </div>
    </div>

    <!-- Teachers Section -->
    <div class="card mt-4">
        <div class="card-header text-white" style="background-color: #008080;">Teachers</div>
        <div class="card-body">
            @if (teachers != null && teachers.Any())
            {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Salary</th>
                        <th>DOB</th>
                        <th>Experience</th>
                        <th>Joining Date</th>
                        <th>Subjects</th>
                        <th>Standards</th>
                        <th>Qualifications</th>
                        <th>Documents</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var teacher in teachers)

                        {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(teacher.details?.Photo))

                                    {
                            <img src="@teacher.details.Photo" alt="Photo" style="width:50px;height:50px;" />
                                    }
                        </td>
                        <td>@teacher.user?.Name</td>
                        <td>@teacher.user?.Email</td>
                        <td>@teacher.details?.Phone</td>
                        <td>@teacher.details?.Address</td>
                        <td>@teacher.details?.Salary.ToString("C")</td>
                        <td>@teacher.details?.Dob.ToShortDateString()</td>
                        <td>@teacher.details?.Experience</td>
                        <td>@teacher.details?.JoiningDate.ToShortDateString()</td>
                        <td>@teacher.details?.Subjects</td>
                        <td>@teacher.details?.Stds</td>
                        <td>@teacher.details?.Qualifications</td>
                        <td>
                            @if (!string.IsNullOrEmpty(teacher.details?.Documents))

                                    {

                                        foreach (var doc in teacher.details.Documents.Split(',', StringSplitOptions.RemoveEmptyEntries))

                                        {
                            <a href="@doc.Trim()" target="_blank">View</a>

                            <br />
                                        }

                                    }
                        </td>
                    </tr>
                        }
                </tbody>
            </table>
            }
            else
            {
            <p class="text-muted">No teachers found.</p>
            }
        </div>
    </div>

    <!-- Staffs Section -->
    <div class="card mt-4">
        <div class="card-header text-white" style="background-color: #008080;">Staffs</div>
        <div class="card-body">
            @if (staffs != null && staffs.Any())
            {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Salary</th>
                        <th>DOB</th>
                        <th>Experience</th>
                        <th>Joining Date</th>
                        <th>Phone</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in staffs)

                        {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(staff.details?.Photo))

                                    {
                            <img src="@staff.details.Photo" alt="Photo" style="width:50px;height:50px;" />
                                    }
                        </td>
                        <td>@staff.user?.Name</td>
                        <td>@staff.user?.Email</td>
                        <td>@staff.details?.Salary.ToString("C")</td>
                        <td>@staff.details?.Dob.ToShortDateString()</td>
                        <td>@staff.details?.Experience</td>
                        <td>@staff.details?.JoiningDate.ToShortDateString()</td>
                        <td>@staff.details?.Phone</td>
                        <td>@staff.details?.Address</td>
                    </tr>
                        }
                </tbody>
            </table>
            }
            else
            {
            <p class="text-muted">No staffs found.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('salaryPieChart').getContext('2d');
        var salaryPieChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: ['Principals', 'Teachers', 'Staffs'],
                datasets: [{
                    label: 'Salary Distribution',
                    data: [
        @principalSalary,
        @teacherSalary,
        @staffSalary
                            ],
                    backgroundColor: [
                        'rgba(54, 162, 235, 0.7)',   // Principals
                        'rgba(255, 99, 132, 0.7)',   // Teachers
                        'rgba(255, 206, 86, 0.7)'    // Staffs
                    ],
                    borderColor: [
                        'rgba(54, 162, 235, 1)',
                        'rgba(255, 99, 132, 1)',
                        'rgba(255, 206, 86, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Total Salary Distribution'
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let value = context.raw.toLocaleString();
                                return `${context.label}: ₹${value}`;
                            }
                        }
                    }
                }
            }
        });
    </script>
}
