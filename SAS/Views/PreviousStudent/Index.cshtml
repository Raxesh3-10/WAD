@model Dictionary<string, Dictionary<int, Dictionary<string, List<SAS.ViewModels.PreviousStudentViewModel>>>>

@{
    ViewData["Title"] = "Previous Students";
}

<h2 class="mt-3">Previous Students</h2>

<!-- Search Section -->
<div class="card mt-4">
    <div class="card-header bg-primary text-white">Search Previous Students</div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3">
                <label>Select Year</label>
                <select id="yearSelect" class="form-control">
                    <option value="">-- Select Year --</option>
                    @foreach (var year in Model.Keys.OrderBy(y => y))

                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label>Select Standard</label>
                <select id="stdSelect" class="form-control" disabled>
                    <option value="">-- Select Std --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Select Division</label>
                <select id="divSelect" class="form-control" disabled>
                    <option value="">-- Select Div --</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Student Results -->
<div class="card mt-4" id="studentResults" style="display:none;">
    <div class="card-header bg-secondary text-white">Student Details</div>
    <div class="card-body">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Roll No</th>
                    <th>Name</th>
                    <th>Father</th>
                    <th>Mother</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Aadhar</th>
                    <th>Std</th>
                    <th>Div</th>
                    <th>Year</th>
                    <th>Photo</th>
                </tr>
            </thead>
            <tbody id="studentTableBody"></tbody>
        </table>
        <p id="noStudentsMsg" class="text-muted" style="display:none;">No students found for the selected filters.</p>
    </div>
</div>

@section Scripts {
    <script>
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        const yearSel = document.getElementById("yearSelect");
        const stdSel = document.getElementById("stdSelect");
        const divSel = document.getElementById("divSelect");
        const results = document.getElementById("studentResults");
        const tbody = document.getElementById("studentTableBody");
        const noMsg = document.getElementById("noStudentsMsg");

        function reset(select, text) {
            select.innerHTML = `<option value="">-- Select ${text} --</option>`;
            select.disabled = true;
        }

        yearSel.onchange = () => {
            reset(stdSel, "Std"); reset(divSel, "Div"); results.style.display = "none";
            if (!yearSel.value) return;
            Object.keys(data[yearSel.value]).sort((a, b) => a - b).forEach(std =>
                stdSel.innerHTML += `<option value="${std}">${std}</option>`);
            stdSel.disabled = false;
        };

        stdSel.onchange = () => {
            reset(divSel, "Div"); results.style.display = "none";
            if (!yearSel.value || !stdSel.value) return;
            Object.keys(data[yearSel.value][stdSel.value]).forEach(div =>
                divSel.innerHTML += `<option value="${div}">${div}</option>`);
            divSel.disabled = false;
        };

        divSel.onchange = () => {
            tbody.innerHTML = ""; noMsg.style.display = "none"; results.style.display = "none";
            let students = data[yearSel.value]?.[stdSel.value]?.[divSel.value] || [];
            if (students.length === 0) { noMsg.style.display = "block"; results.style.display = "block"; return; }
            students.forEach(s => {
                tbody.innerHTML += `
                          <tr>
                            <td>${s.RollNo}</td><td>${s.StudentName}</td>
                            <td>${s.FatherName}</td><td>${s.MotherName}</td>
                            <td>${s.Email}</td><td>${s.PhoneNo}</td>
                            <td>${s.AadharNo}</td><td>${s.Std}</td>
                            <td>${s.Div}</td><td>${s.PassingYear}</td>
                            <td>${s.PhotoUrl ? `<img src="${s.PhotoUrl}" style="width:50px;height:50px;" />` : "N/A"}</td>
                          </tr>`;
            });
            results.style.display = "block";
        };
    </script>
}
