@{
    ViewData["Title"] = "Staff Dashboard";
    var profile = ViewBag.Profile as SAS.ViewModels.UserViewModel;
}

<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="text-primary">Welcome, @profile.Name <small class="text-muted">(@profile.Role)</small></h3>
            <p><strong>Email:</strong> @profile.Email</p>
        </div>
    </div>

    @await Component.InvokeAsync("NoticeReadonly")
    @await Component.InvokeAsync("BillsList")
    @await Component.InvokeAsync("ReportBug", new { name = profile?.Name, email = profile?.Email })
</div>
